{
  "openapi": "3.1.0",
  "info": {
    "title": "Golden",
    "summary": "One document using every object the library models, each feature once.",
    "description": "Loaded, validated and written back, it must come out byte for byte as it is here. Edit it by hand: a change here is a change in what the library reads or writes.",
    "termsOfService": "https://example.com/terms/",
    "contact": {
      "name": "API Support",
      "url": "https://www.example.com/support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Apache 2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "servers": [
    {
      "url": "https://development.example.com/v1",
      "description": "Development server"
    },
    {
      "url": "https://{username}.example.com:{port}/{basePath}",
      "description": "Server variables",
      "variables": {
        "username": {
          "default": "demo",
          "description": "this value is assigned by the service provider"
        },
        "port": {
          "enum": [
            "8443",
            "443"
          ],
          "default": "8443"
        },
        "basePath": {
          "default": "v2"
        }
      }
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "tags": [
          "pet"
        ],
        "summary": "Parameters of every location and style, responses with headers, links and examples",
        "description": "Security is removed by an empty list, unlike an absent one; 529 is a status code net/http does not know.",
        "externalDocs": {
          "url": "https://example.com/docs/pets"
        },
        "operationId": "listPets",
        "parameters": [
          {
            "$ref": "#/components/parameters/skipParam"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "repeated for each value",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "token",
            "in": "header",
            "description": "an array of 64 bit integers",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          {
            "name": "freeForm",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          {
            "name": "coordinates",
            "in": "query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lat": {
                      "type": "number"
                    },
                    "long": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "lat",
                    "long"
                  ]
                }
              }
            }
          },
          {
            "name": "zip",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}(-\\d{4})?$"
            },
            "examples": {
              "zip": {
                "$ref": "#/components/examples/zip"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "pets, rate limited",
            "headers": {
              "X-Rate-Limit": {
                "$ref": "#/components/headers/X-Rate-Limit"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                },
                "examples": {
                  "frog": {
                    "$ref": "#/components/examples/frog"
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "whoa!"
              }
            },
            "links": {
              "pet": {
                "$ref": "#/components/links/GetPet"
              }
            }
          },
          "529": {
            "description": "overloaded"
          },
          "default": {
            "$ref": "#/components/responses/GeneralError"
          }
        },
        "security": []
      },
      "post": {
        "tags": [
          "pet"
        ],
        "operationId": "createPet",
        "requestBody": {
          "$ref": "#/components/requestBodies/Pet"
        },
        "responses": {
          "201": {
            "description": "created",
            "links": {
              "byOperationRef": {
                "operationRef": "#/paths/~1pets~1{id}/get",
                "parameters": {
                  "id": "$response.body#/id"
                }
              },
              "absolute": {
                "operationRef": "https://na2.gigantic-server.com/#/paths/~1users~1{userid}/get",
                "description": "a runtime expression that fails to evaluate passes no value"
              }
            }
          }
        },
        "callbacks": {
          "onData": {
            "$ref": "#/components/callbacks/onData"
          },
          "fixedServer": {
            "http://notificationServer.com?transactionId={$request.body#/id}&email={$request.body#/email}": {
              "$ref": "#/components/pathItems/Notification"
            }
          }
        },
        "deprecated": true,
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ],
        "servers": [
          {
            "url": "https://write.example.com/v1"
          }
        ]
      }
    },
    "/pets/{id}": {
      "summary": "A path parameter shared by the operations, and servers of its own",
      "servers": [
        {
          "url": "https://pets.example.com"
        }
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getPet",
        "responses": {
          "200": {
            "description": "the pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "requestBody": {
          "description": "multipart, each part encoded its own way",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "address": {
                    "type": "object"
                  },
                  "profileImage": {
                    "type": "string",
                    "contentMediaType": "image/png",
                    "contentEncoding": "base64"
                  }
                }
              },
              "encoding": {
                "address": {
                  "contentType": "application/json",
                  "style": "form",
                  "explode": true,
                  "allowReserved": true
                },
                "profileImage": {
                  "contentType": "image/png, image/jpeg",
                  "headers": {
                    "X-Rate-Limit-Limit": {
                      "description": "The number of allowed requests in the current period",
                      "schema": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "operationId": "upload",
        "requestBody": {
          "content": {
            "application/octet-stream": {},
            "image/png": {
              "schema": {
                "type": "string",
                "contentMediaType": "image/png",
                "contentEncoding": "base64"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "external": {
                  "summary": "an example kept elsewhere",
                  "externalValue": "https://example.org/examples/upload.txt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "uploaded"
          }
        }
      }
    }
  },
  "webhooks": {
    "newPet": {
      "post": {
        "requestBody": {
          "$ref": "#/components/requestBodies/Pet"
        },
        "responses": {
          "200": {
            "description": "received"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "description": "A parent other components extend through allOf may carry the discriminator; mapping values are names or references.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "petType": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "owner": {
            "description": "a reference with keywords beside it",
            "deprecated": true,
            "$ref": "#/components/schemas/Owner"
          }
        },
        "required": [
          "id",
          "petType"
        ],
        "discriminator": {
          "propertyName": "petType",
          "mapping": {
            "cat": "Cat",
            "dog": "#/components/schemas/Dog"
          }
        },
        "x-go-name": "Animal"
      },
      "Cat": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pet"
          },
          {
            "type": "object",
            "properties": {
              "lives": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9,
                "default": 9
              }
            }
          }
        ]
      },
      "Dog": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pet"
          },
          {
            "type": "object",
            "properties": {
              "size": {
                "type": "string",
                "enum": [
                  "small",
                  "large"
                ],
                "default": "small"
              }
            }
          }
        ]
      },
      "Owner": {
        "title": "A reference target, and an alias that is only a reference",
        "$ref": "#/components/schemas/Node"
      },
      "Node": {
        "description": "A tree: a schema may lead back to itself through properties or items.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\u00e0-\\u00ff\\w]+$"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "default": []
          }
        }
      },
      "Shape": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Cat"
          },
          {
            "$ref": "#/components/schemas/Dog"
          }
        ],
        "discriminator": {
          "propertyName": "petType"
        }
      },
      "Either": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number",
            "enum": [
              1.5,
              2
            ]
          }
        ]
      },
      "Nullable": {
        "title": "Boolean",
        "description": "a type array of one type and null: the 3.1 form of nullable",
        "type": [
          "boolean",
          "null"
        ],
        "example": null
      },
      "Null": {
        "type": "null",
        "enum": [
          null
        ]
      },
      "Tuple": {
        "description": "positionally typed, with items covering any element beyond those listed",
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "items": {
          "type": "boolean"
        }
      },
      "Origin": {
        "type": "array",
        "enum": [
          [
            0,
            0
          ]
        ],
        "items": {
          "type": "integer"
        }
      },
      "Closed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Open": {
        "type": "object",
        "additionalProperties": true,
        "default": {}
      },
      "AnyValues": {
        "description": "present but empty differs from absent, so it is written back",
        "type": "object",
        "additionalProperties": {}
      },
      "Directions": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "maxProperties": 2,
        "propertyNames": {
          "enum": [
            "north",
            "south"
          ]
        }
      },
      "Size": {
        "type": "integer",
        "format": "int32",
        "exclusiveMinimum": 0,
        "multipleOf": 4,
        "examples": [
          64
        ]
      },
      "BadRequest": {
        "type": "integer",
        "const": 400
      },
      "Nothing": {
        "description": "no value is valid: the enum lists none",
        "type": "string",
        "enum": []
      },
      "NotAnything": {
        "not": {}
      },
      "Untyped": {
        "description": "keywords of a type apply without one, and required may name what only a branch declares",
        "format": "date-time",
        "required": [
          "kind"
        ]
      },
      "GeneralError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        },
        "x-internal": true
      }
    },
    "responses": {
      "GeneralError": {
        "description": "General Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GeneralError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Entity not found."
      }
    },
    "parameters": {
      "skipParam": {
        "name": "skip",
        "in": "query",
        "description": "number of items to skip",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "examples": {
      "frog": {
        "summary": "An example of a list of pets",
        "value": [
          {
            "id": "1",
            "petType": "frog"
          }
        ]
      },
      "zip": {
        "value": "92054"
      }
    },
    "requestBodies": {
      "Pet": {
        "description": "Pet to add to the store",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Pet"
            }
          }
        }
      }
    },
    "headers": {
      "X-Rate-Limit": {
        "description": "calls per hour allowed by the user",
        "schema": {
          "type": "integer"
        }
      }
    },
    "securitySchemes": {
      "basic": {
        "type": "http",
        "scheme": "basic"
      },
      "api_key": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "petstore_auth": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/api/oauth/dialog",
            "scopes": {
              "write:pets": "modify pets in your account",
              "read:pets": "read your pets"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://example.com/api/oauth/dialog",
            "tokenUrl": "https://example.com/api/oauth/token",
            "refreshUrl": "https://example.com/api/oauth/refresh",
            "scopes": {}
          }
        }
      },
      "openId": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://example.com/.well-known/openid-configuration"
      }
    },
    "links": {
      "GetPet": {
        "operationId": "getPet",
        "parameters": {
          "id": "$request.path.id"
        },
        "requestBody": "$response.body#/id",
        "server": {
          "url": "https://pets.example.com"
        }
      }
    },
    "callbacks": {
      "onData": {
        "{$request.query.callbackUrl}/data": {
          "post": {
            "requestBody": {
              "description": "Callback payload",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Pet"
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "callback successfully processed"
              }
            }
          }
        }
      }
    },
    "pathItems": {
      "Notification": {
        "post": {
          "responses": {
            "200": {
              "description": "notified"
            }
          }
        }
      }
    }
  },
  "security": [
    {},
    {
      "api_key": []
    }
  ],
  "tags": [
    {
      "name": "pet",
      "description": "Everything about your Pets",
      "externalDocs": {
